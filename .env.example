# Shared credentials (used by Docker Postgres and Spring datasources)
SPRING_DATASOURCE_USERNAME=original-username
SPRING_DATASOURCE_PASSWORD=original-password

# Commerce datasource (PostgreSQL database name)
COMMERCE_DATASOURCE_DB=taller-java-db

# Payments datasource (H2 by default; override only if needed)
PAYMENTS_DATASOURCE_URL=jdbc:h2:file:./data/payments-service;MODE=PostgreSQL;DATABASE_TO_UPPER=false

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# Payments business config
APP_PAYMENTS_MAX_SUCCESS_AMOUNT=1000.00

# JWT (commerce-app)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=36000000
JWT_REFRESH_EXPIRATION=604800000

# Commerce bootstrap admin
APP_BOOTSTRAP_FIRST_NAME=AdminTest
APP_BOOTSTRAP_LAST_NAME=UserAutoGenerated
APP_BOOTSTRAP_EMAIL=admin@test.com
APP_BOOTSTRAP_PASSWORD=Admin123!
APP_BOOTSTRAP_PHONE=1234567890

